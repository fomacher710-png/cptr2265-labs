# Copy this file to .env and fill in real values. NEVER commit .env to Git
# (add it to .gitignore AND .dockerignore). Commit this .env.example instead
# so teammates know which variables to set.
# Docker Compose reads .env automatically from the folder you run it in.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb
APP_PORT=8080
APP_ENV=development
